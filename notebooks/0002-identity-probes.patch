+   "cell_type": "code",
+   "metadata": {},
+   "execution_count": null,
+   "outputs": [],
+   "source": [
+    "probes = ip.fit_probes(X, Y)\n",
+    "usable_heseia = quality.index[quality[\"usable\"].fillna(False)].tolist()\n",
